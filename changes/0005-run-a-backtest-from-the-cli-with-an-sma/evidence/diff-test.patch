++    lines = capsys.readouterr().out.splitlines()
++    assert lines == expected_lines(3, 5, 0.001)
++    assert lines[0] == (
++        "BTC-USDT 1h spot, 2026-10-01 .. 2026-10-01: 24 candles; sma-cross fast 3 slow 5; fee 0.10%"
++    )
++    assert all(len(line) == 22 for line in lines[2:])
++
++
