+"""The long/flat engine: one forward pass that fills each decision at the next row's open."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+import polars as pl
+
+from app.backtest.inputs import DEFAULT_FEE, Inputs, validate
+from app.backtest.summary import START_EQUITY, Summary, summarize
+
+
+@dataclass(frozen=True)
+class BacktestResult:
+    """The equity per row (marked at close), the closed trades and the summary."""
+
+    equity: pl.DataFrame
+    trades: pl.DataFrame
+    summary: Summary
+
+
+@dataclass(frozen=True)
+class _Trade:
+    entry_row: int
+    entry_price: float
+    exit_row: int
+    exit_price: float
+    ret: float
+    closed_at_end: bool
+
+
+@dataclass
+class _Pass:
+    equity: list[float]
+    held: list[int]
+    trades: list[_Trade] = field(default_factory=list)
+
+
+def run_backtest(
+    frame: pl.DataFrame, positions: pl.Series | Sequence[int], *, fee: float = DEFAULT_FEE
+) -> BacktestResult:
+    """Backtest long/flat `positions` (0 or 1, decided at each row's close) on `frame`.
+
+    Each decision fills at the next row's open, whatever the gap; a position still long after
+    the last row's open is closed at the last close. Raises BacktestInputError on bad input.
+    """
+    inputs = validate(frame, positions, fee)
+    run = _simulate(inputs)
+    return BacktestResult(
+        equity=_equity_frame(inputs.open_time, run),
+        trades=_trades_frame(inputs.open_time, run.trades),
+        summary=summarize(run.equity, run.held, [trade.ret for trade in run.trades]),
+    )
+
+
+def _simulate(inputs: Inputs) -> _Pass:
+    fee = inputs.fee
+    opens, closes = inputs.opens, inputs.closes
+    cash, coins, held = START_EQUITY, 0.0, 0
+    entry_row, entry_cash = 0, 0.0
+    run = _Pass(equity=[START_EQUITY], held=[0])
+    for row in range(1, len(opens)):
+        target = inputs.positions[row - 1]
+        if target != held:
+            if target:
+                entry_row, entry_cash = row, cash
+                coins, cash = cash * (1 - fee) / opens[row], 0.0
+            else:
+                cash, coins = coins * opens[row] * (1 - fee), 0.0
+                run.trades.append(
+                    _Trade(
+                        entry_row, opens[entry_row], row, opens[row], cash / entry_cash - 1, False
+                    )
+                )
+            held = target
+        run.held.append(held)
+        run.equity.append(coins * closes[row] if held else cash)
+    if held:
+        last = len(closes) - 1
+        cash = coins * closes[last] * (1 - fee)
+        run.trades.append(
+            _Trade(entry_row, opens[entry_row], last, closes[last], cash / entry_cash - 1, True)
+        )
+        run.equity[last] = cash
+    return run
+
+
+def _equity_frame(open_time: pl.Series, run: _Pass) -> pl.DataFrame:
+    return pl.DataFrame(
+        [
+            open_time,
+            pl.Series("position", run.held, dtype=pl.Int8),
+            pl.Series("equity", run.equity, dtype=pl.Float64),
+        ]
+    )
+
+
+def _trades_frame(open_time: pl.Series, trades: list[_Trade]) -> pl.DataFrame:
+    return pl.DataFrame(
+        [
+            open_time.gather([trade.entry_row for trade in trades]).alias("entry_time"),
+            pl.Series("entry_price", [trade.entry_price for trade in trades], dtype=pl.Float64),
+            open_time.gather([trade.exit_row for trade in trades]).alias("exit_time"),
+            pl.Series("exit_price", [trade.exit_price for trade in trades], dtype=pl.Float64),
+            pl.Series("return", [trade.ret for trade in trades], dtype=pl.Float64),
+            pl.Series("closed_at_end", [trade.closed_at_end for trade in trades], dtype=pl.Boolean),
+        ]
+    )
diff --git a/app/backtest/inputs.py b/app/backtest/inputs.py
new file mode 100644
index 0000000..fb2b189
--- /dev/null
+++ b/app/backtest/inputs.py
@@ -0,0 +1,110 @@
+"""Backtest inputs: the frame, the positions and the fee, checked before any calculation."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import polars as pl
+
+DEFAULT_FEE = 0.001
+REQUIRED_COLUMNS = ("open_time", "open", "close")
+
+
+class BacktestInputError(ValueError):
+    """A frame, position series or fee the backtest engine refuses."""
+
+
+@dataclass(frozen=True)
+class Inputs:
+    open_time: pl.Series
+    opens: list[float]
+    closes: list[float]
+    positions: list[int]
+    fee: float
+
+
+def validate(frame: pl.DataFrame, positions: pl.Series | Sequence[int], fee: float) -> Inputs:
+    checked_fee = _check_fee(fee)
+    opens, closes = _check_frame(frame)
+    checked_positions = _check_positions(positions, frame.height)
+    return Inputs(
+        open_time=frame["open_time"],
+        opens=opens,
+        closes=closes,
+        positions=checked_positions,
+        fee=checked_fee,
+    )
+
+
+def _check_fee(fee: float) -> float:
+    if isinstance(fee, bool) or not isinstance(fee, (int, float)):
+        raise BacktestInputError(
+            f"fee {fee!r} is not a number: pass a proportional fee as a float, for example 0.001"
+        )
+    if not 0 <= fee < 1:
+        raise BacktestInputError(
+            f"fee {fee!r} is out of range: it must be at least 0 and below 1, for example 0.001"
+        )
+    return float(fee)
+
+
+def _check_frame(frame: pl.DataFrame) -> tuple[list[float], list[float]]:
+    if not isinstance(frame, pl.DataFrame):
+        raise BacktestInputError(
+            f"frame is a {type(frame).__name__}: pass a polars DataFrame such as load_klines returns"
+        )
+    missing = [name for name in REQUIRED_COLUMNS if name not in frame.columns]
+    if missing:
+        raise BacktestInputError(
+            f"frame lacks the column(s) {', '.join(missing)}: it needs "
+            f"{', '.join(REQUIRED_COLUMNS)}"
+        )
+    if frame.height == 0:
+        raise BacktestInputError("frame is empty: pass at least one candle")
+    _check_open_time(frame["open_time"])
+    return _check_prices(frame["open"]), _check_prices(frame["close"])
+
+
+def _check_open_time(open_time: pl.Series) -> None:
+    nulls = open_time.is_null().arg_true()
+    if nulls.len():
+        raise BacktestInputError(f"open_time[{nulls[0]}] is null: every row needs an open_time")
+    earlier = open_time.slice(0, open_time.len() - 1)
+    later = open_time.slice(1)
+    not_increasing = (later <= earlier).arg_true()
+    if not_increasing.len():
+        row = not_increasing[0] + 1
+        raise BacktestInputError(
+            f"open_time[{row}] is {open_time[row]!r}, not after open_time[{row - 1}] "
+            f"{open_time[row - 1]!r}: open_time must be strictly increasing"
+        )
+
+
+def _check_prices(column: pl.Series) -> list[float]:
+    if not column.dtype.is_numeric():
+        raise BacktestInputError(f"{column.name} has dtype {column.dtype}: prices must be numbers")
+    prices = column.cast(pl.Float64).to_list()
+    for row, value in enumerate(prices):
+        if value is None or not math.isfinite(value) or value <= 0:
+            raise BacktestInputError(
+                f"{column.name}[{row}] is {value!r}: every price must be a finite number above 0"
+            )
+    return prices
+
+
+def _check_positions(positions: pl.Series | Sequence[int], height: int) -> list[int]:
+    values = positions.to_list() if isinstance(positions, pl.Series) else list(positions)
+    if len(values) != height:
+        raise BacktestInputError(
+            f"positions has {len(values)} values but the frame has {height} rows: "
+            "pass one position per row"
+        )
+    for row, value in enumerate(values):
+        if type(value) is not int or value not in (0, 1):
+            raise BacktestInputError(
+                f"positions[{row}] is {value!r}: each position must be the integer 0 (flat) "
+                "or 1 (long); cast a Boolean or Float series with .cast(pl.Int8)"
+            )
+    return values
diff --git a/app/backtest/summary.py b/app/backtest/summary.py
new file mode 100644
index 0000000..c08afd9
--- /dev/null
+++ b/app/backtest/summary.py
@@ -0,0 +1,42 @@
+"""The backtest summary: five numbers computed from the equity curve and the trades."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+START_EQUITY = 1.0
+
+
+@dataclass(frozen=True)
+class Summary:
+    """Total return, max drawdown, trade count, win rate and time in market.
+
+    `win_rate` is the share of trades whose return after fees is above 0: 0.0 when there are
+    no trades; see trade_count. `time_in_market` counts rows, not wall time.
+    """
+
+    total_return: float
+    max_drawdown: float
+    trade_count: int
+    win_rate: float
+    time_in_market: float
+
+
+def summarize(equity: list[float], held: list[int], returns: list[float]) -> Summary:
+    wins = sum(1 for value in returns if value > 0)
+    return Summary(
+        total_return=equity[-1] / START_EQUITY - 1,
+        max_drawdown=max_drawdown(equity),
+        trade_count=len(returns),
+        win_rate=wins / len(returns) if returns else 0.0,
+        time_in_market=sum(held) / len(held),
+    )
+
+
+def max_drawdown(equity: list[float]) -> float:
+    peak = equity[0]
+    worst = 0.0
+    for value in equity:
+        peak = max(peak, value)
+        worst = max(worst, 1 - value / peak)
+    return worst
